# Copy to /srv/florque/.env (chmod 600). Never commit the filled-in file.

# Public host name; DNS A/AAAA records must point at the server before the first start.
FLORQUE_DOMAIN=wg.example.com
# Image tag to run (a release tag such as v0.2.0, or latest)
FLORQUE_TAG=latest

# Neo4j (bootstrap.sh generates a random password when this is empty)
NEO4J_PASSWORD=
# Memory for a 8 GB server (CX32/CPX31); about 25 % heap and 25 % page cache
NEO4J_HEAP=2g
NEO4J_PAGECACHE=2g

# Email through Resend (https://resend.com): the sender domain must be verified there
RESEND_API_KEY=
FLORQUE_EMAIL_FROM=Florque Workgraph <beta@example.com>

# Shown in invite emails
FLORQUE_CLI_INSTALL=uv tool install florque-cli --find-links https://wg.example.com/dist/
# Clients older than this get an upgrade warning
FLORQUE_MIN_CLIENT=0.2.0

# Requests per minute: per token (or IP), and per IP on /v1/auth
FLORQUE_RATE_LIMIT=600
FLORQUE_AUTH_RATE_LIMIT=20
FLORQUE_LOG_LEVEL=INFO

# Litestream -> Hetzner Object Storage (or any S3)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=florque-backups
LITESTREAM_ENDPOINT=https://fsn1.your-objectstorage.com
LITESTREAM_REGION=fsn1
# Neo4j dumps go to the same bucket (backup-neo4j.sh)
BACKUP_S3_PREFIX=florque/neo4j
